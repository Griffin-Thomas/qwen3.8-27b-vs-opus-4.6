+    def test_denied_requests_do_not_extend_blocking(self):
+        """Customers who back off after exceeding the limit must recover."""
+        clock = FakeClock()
+        limiter = SlidingWindowLimiter(limit=3, window=60, clock=clock)
+
+        for _ in range(3):
+            self.assertTrue(limiter.allow("alice"))
+
+        # Exceed the limit with several denied attempts.
+        for _ in range(10):
+            clock.advance(1)
+            self.assertFalse(limiter.allow("alice"))
+
+        # After the full window elapses past the last *allowed* request,
+        # the customer must be unblocked.
+        clock.advance(60)
+        self.assertTrue(limiter.allow("alice"))
+
+    def test_no_burst_across_subsecond_boundary(self):
+        """Subsecond timing must not allow more than limit in a window."""
+        clock = FakeClock(start=1000.0)
+        limiter = SlidingWindowLimiter(limit=5, window=10, clock=clock)
+
+        # Fill the limit right before a whole-second boundary.
+        clock.now = 1000.99
+        for _ in range(5):
+            self.assertTrue(limiter.allow("alice"))
+
+        # Just past the boundary, only ~9 real seconds later — all 5 must
+        # still be in the window.
+        clock.now = 1010.01
+        self.assertFalse(limiter.allow("alice"))
+
+    def test_recovery_after_full_window(self):
+        """A blocked customer regains full capacity once the window passes."""
+        clock = FakeClock()
+        limiter = SlidingWindowLimiter(limit=2, window=30, clock=clock)
+
+        self.assertTrue(limiter.allow("alice"))
+        self.assertTrue(limiter.allow("alice"))
+        self.assertFalse(limiter.allow("alice"))
+
+        clock.advance(31)
+        self.assertTrue(limiter.allow("alice"))
+        self.assertTrue(limiter.allow("alice"))
