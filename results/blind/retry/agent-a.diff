+class TestRetry(unittest.TestCase):
+    def _make_client(self, script, **kwargs):
+        transport = ScriptedTransport(script)
+        delays = []
+        client = Client(transport, sleep=delays.append, **kwargs)
+        return client, transport, delays
+
+    def test_retries_connection_error_then_succeeds(self):
+        client, transport, delays = self._make_client([
+            ConnectionError("reset"), Response(200, "ok"),
+        ])
+        resp = client.request("GET", "/things")
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(len(transport.sends), 2)
+        self.assertEqual(delays, [1])
+
+    def test_retries_503_then_succeeds(self):
+        client, transport, delays = self._make_client([
+            Response(503, "unavailable"), Response(200, "ok"),
+        ])
+        resp = client.request("GET", "/things")
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(len(transport.sends), 2)
+
+    def test_retries_429_then_succeeds(self):
+        client, transport, delays = self._make_client([
+            Response(429, "slow down"), Response(200, "ok"),
+        ])
+        resp = client.request("GET", "/things")
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(len(transport.sends), 2)
+
+    def test_does_not_retry_4xx(self):
+        client, transport, delays = self._make_client([
+            Response(400, "bad request"), Response(200, "ok"),
+        ])
+        with self.assertRaises(HTTPError) as ctx:
+            client.request("POST", "/things")
+        self.assertEqual(ctx.exception.status, 400)
+        self.assertEqual(len(transport.sends), 1)
+        self.assertEqual(delays, [])
+
+    def test_exponential_backoff_delays(self):
+        client, transport, delays = self._make_client([
+            ConnectionError("reset"),
+            ConnectionError("reset"),
+            ConnectionError("reset"),
+            Response(200, "ok"),
+        ])
+        resp = client.request("GET", "/things")
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(delays, [1, 2, 4])
+
+    def test_exhausts_retries_on_connection_error(self):
+        client, transport, delays = self._make_client([
+            ConnectionError("reset"),
+        ])
+        with self.assertRaises(ConnectionError):
+            client.request("GET", "/things")
+        self.assertEqual(len(transport.sends), 4)
+
+    def test_exhausts_retries_on_server_error(self):
+        client, transport, delays = self._make_client([
+            Response(502, "bad gateway"),
+        ])
+        with self.assertRaises(HTTPError) as ctx:
+            client.request("GET", "/things")
+        self.assertEqual(ctx.exception.status, 502)
+        self.assertEqual(len(transport.sends), 4)
+
+    def test_custom_retries_and_base_delay(self):
+        client, transport, delays = self._make_client(
+            [ConnectionError("reset"), Response(200, "ok")],
+            retries=1, base_delay=5,
+        )
+        resp = client.request("GET", "/things")
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(delays, [5])
+
+
 if __name__ == "__main__":
