+# Statuses that are worth retrying: rate limits and server-side faults.
+# 501 (Not Implemented) is deliberately excluded, as are all other 4xx.
+_RETRYABLE_STATUSES = {429, 500, 502, 503, 504}
+_MAX_ATTEMPTS = 4
+_INITIAL_DELAY = 0.5
+_MAX_DELAY = 8.0
+
+
