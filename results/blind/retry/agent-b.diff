+class TestRetry(unittest.TestCase):
+    def make_client(self, transport):
+        self.delays = []
+        return Client(transport, sleep=self.delays.append)
+
+    def test_connection_error_retried_then_succeeds(self):
+        transport = ScriptedTransport([
+            ConnectionError("dropped"),
+            Response(200, "ok"),
+        ])
+        client = self.make_client(transport)
+        response = client.request("GET", "/things")
+        self.assertEqual(response.status, 200)
+        self.assertEqual(len(transport.sends), 2)
+        self.assertEqual(self.delays, [0.5])
+
+    def test_503_storm_retried_then_succeeds(self):
+        transport = ScriptedTransport([
+            Response(503, "unavailable"),
+            Response(503, "unavailable"),
+            Response(200, "ok"),
+        ])
+        client = self.make_client(transport)
+        response = client.request("GET", "/things")
+        self.assertEqual(response.status, 200)
+        self.assertEqual(self.delays, [0.5, 1.0])
+
+    def test_429_retried_then_succeeds(self):
+        transport = ScriptedTransport([
+            Response(429, "slow down"),
+            Response(200, "ok"),
+        ])
+        client = self.make_client(transport)
+        response = client.request("GET", "/things")
+        self.assertEqual(response.status, 200)
+        self.assertEqual(len(transport.sends), 2)
+
+    def test_exponential_backoff_delays(self):
+        transport = ScriptedTransport([ConnectionError("dropped")])
+        client = self.make_client(transport)
+        with self.assertRaises(ConnectionError):
+            client.request("GET", "/things")
+        self.assertEqual(len(transport.sends), 4)
+        self.assertEqual(self.delays, [0.5, 1.0, 2.0])
+
+    def test_exhausted_5xx_raises_http_error(self):
+        transport = ScriptedTransport([Response(500, "boom")])
+        client = self.make_client(transport)
+        with self.assertRaises(HTTPError) as ctx:
+            client.request("GET", "/things")
+        self.assertEqual(ctx.exception.status, 500)
+        self.assertEqual(ctx.exception.body, "boom")
+        self.assertEqual(len(transport.sends), 4)
+
+    def test_501_not_retried(self):
+        transport = ScriptedTransport([Response(501, "nope")])
+        client = self.make_client(transport)
+        with self.assertRaises(HTTPError) as ctx:
+            client.request("GET", "/things")
+        self.assertEqual(ctx.exception.status, 501)
+        self.assertEqual(len(transport.sends), 1)
+        self.assertEqual(self.delays, [])
+
+    def test_400_not_retried(self):
+        transport = ScriptedTransport([Response(400, "bad")])
+        client = self.make_client(transport)
+        with self.assertRaises(HTTPError):
+            client.request("GET", "/things")
+        self.assertEqual(len(transport.sends), 1)
+
+    def test_success_no_sleep(self):
+        transport = ScriptedTransport([Response(200, "ok")])
+        client = self.make_client(transport)
+        client.request("GET", "/things")
+        self.assertEqual(self.delays, [])
+
+
